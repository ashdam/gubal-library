<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../PackContents.cs" Link="PackContents.cs" />
    <Compile Include="../../../PackParts.cs" Link="PackParts.cs" />
    <Compile Include="../../../PackCompatibility.cs" Link="PackCompatibility.cs" />
    <Compile Include="../../../Configuration.cs" Link="Configuration.cs" />
    <Compile Include="../../../PackManifest.cs" Link="PackManifest.cs" />
    <Compile Include="../../../PackVersion.cs" Link="PackVersion.cs" />
    <Compile Include="../../../Diagnostics.cs" Link="Diagnostics.cs" />
    <None Include="../../../loc/*.json" Link="loc/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
