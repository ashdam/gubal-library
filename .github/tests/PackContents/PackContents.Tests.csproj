<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier />
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(LocalizationTreePath)" LogicalName="GubalLibrary.sheet-category-tree.json" />
    <Compile Include="../../../src/Gubal.Plugin/PackContents.cs" Link="PackContents.cs" />
    <Compile Include="../../../src/Gubal.Core/PackParts.cs" Link="PackParts.cs" />
    <Compile Include="../../../src/Gubal.Core/CoreLanguage.cs" Link="CoreLanguage.cs" />
    <Compile Include="../../../src/Gubal.Plugin/PackCompatibility.cs" Link="PackCompatibility.cs" />
    <Compile Include="../../../src/Gubal.Plugin/Configuration.cs" Link="Configuration.cs" />
    <Compile Include="../../../src/Gubal.Core/PackManifest.cs" Link="PackManifest.cs" />
    <Compile Include="../../../src/Gubal.Core/PackVersion.cs" Link="PackVersion.cs" />
    <Compile Include="../../../src/Gubal.Plugin/Diagnostics.cs" Link="Diagnostics.cs" />
    <None Include="../../../loc/*.json" Link="loc/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
