<!-- The SDK version is set in global.json and determines the published Dalamud API level. -->
<Project Sdk="Dalamud.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <AssemblyName>GubalLibrary</AssemblyName>
    <RootNamespace>GubalLibrary</RootNamespace>
    <Version>0.6.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GubalUsageLocal)' == 'true'">
    <DefineConstants>$(DefineConstants);GUBAL_USAGE_LOCAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CheapLoc">
      <HintPath>$(DalamudLibPath)CheapLoc.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Screenshots must not contain other players' names or chat. -->
  <ItemGroup>
    <EmbeddedResource Include="images\icon.png" />
    <EmbeddedResource Include="images\tooltips\*.png" />
    <EmbeddedResource Include="images\example7.png" LogicalName="GubalLibrary.images.tooltips.codex.png" />
    <EmbeddedResource Include="images\flags\*.png" />
    <EmbeddedResource Include="images\expansions\*.jpg" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="loc\*.json" LogicalName="GubalLibrary.loc.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
