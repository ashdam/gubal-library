<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <AssemblyName>GubalLibrary</AssemblyName>
    <RootNamespace>GubalLibrary</RootNamespace>
    <Version>0.2.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    Nothing is bundled, by design, and there is no longer even a sample.

    A language pack is tens of MB across thousands of files, is derived from the game's own data,
    and is regenerated whenever the game is patched, so it ships neither in the repository nor in
    the distribution zip. The user points the plugin at a folder.

    There used to be a two-line sample here, so that a correct install could be told from a broken
    one. It went with the injection engine it was for: the file route cannot demonstrate itself on
    two lines, because it only shows anything after a restart, and the settings window now answers
    the same question directly by reporting how many reads have actually been served.
  -->

</Project>
